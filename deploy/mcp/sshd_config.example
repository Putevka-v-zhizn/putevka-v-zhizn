# Install as /etc/ssh/sshd_config.d/60-putevka-mcp.conf and run sshd -t.
Match User putevka-mcp
    AuthorizedKeysFile /etc/ssh/authorized_keys/putevka-mcp
    AuthenticationMethods publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    DisableForwarding yes
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no
    PermitTTY no
    PermitUserRC no
    MaxSessions 1
    ForceCommand /usr/bin/sudo -n /usr/local/sbin/putevka-mcp-session
Match all
