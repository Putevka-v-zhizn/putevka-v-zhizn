# Store the real file at /etc/putevka-mcp/runtime.env, root:root mode 0600.
# Never reuse DATABASE_URL or the web application's database role.
MCP_DATABASE_URL=postgresql://putevka_mcp_reader:CHANGE_ME@db:5432/putevka?sslmode=disable
# For a remote PostgreSQL server, require TLS verification: sslmode=verify-full.
# Generate locally on the server: python3 -c 'import secrets; print(secrets.token_hex(32))'
MCP_HMAC_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET
MCP_DOCKER_NETWORK=putevka_app

# Main production has no NTO module yet. Enable it after deploying that app.
MCP_PROGRAMS=main,family_income
